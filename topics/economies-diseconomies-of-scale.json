2r3c1","text":{"en":[{"text":"2"}],"zh":[{"text":"2"}]}},{"id":"pp-DSE2025_P1_Q6-s-2r3c2","text":{"en":[{"text":"50"}],"zh":[{"text":"50"}]}}]},{"id":"pp-DSE2025_P1_Q6-s-2r4","cells":[{"id":"pp-DSE2025_P1_Q6-s-2r4c1","text":{"en":[{"text":"3"}],"zh":[{"text":"3"}]}},{"id":"pp-DSE2025_P1_Q6-s-2r4c2","text":{"en":[{"text":"90"}],"zh":[{"text":"90"}]}}]},{"id":"pp-DSE2025_P1_Q6-s-2r5","cells":[{"id":"pp-DSE2025_P1_Q6-s-2r5c1","text":{"en":[{"text":"4"}],"zh":[{"text":"4"}]}},{"id":"pp-DSE2025_P1_Q6-s-2r5c2","text":{"en":[{"text":"100"}],"zh":[{"text":"100"}]}}]},{"id":"pp-DSE2025_P1_Q6-s-2r6","cells":[{"id":"pp-DSE2025_P1_Q6-s-2r6c1","text":{"en":[{"text":"5"}],"zh":[{"text":"5"}]}},{"id":"pp-DSE2025_P1_Q6-s-2r6c2","text":{"en":[{"text":"105"}],"zh":[{"text":"105"}]}}]}]},{"kind":"paragraph","id":"pp-DSE2025_P1_Q6-s-3","text":{"en":[{"text":"Based on the above information, we can conclude that _____."}],"zh":[{"text":"根據以上資料，可得出的結論是：____。"}]}}],"marks":1,"options":[{"id":"pp-DSE2025_P1_Q6-a","text":{"en":[{"text":"the law of diminishing marginal returns applies to the firm because when the 4th unit of labour is employed, marginal product starts to diminish"}],"zh":[{"text":"邊際回報遞減定律適用於該廠商，因為當僱用第 4 個勞力單位時，邊際產量開始遞減"}]}},{"id":"pp-DSE2025_P1_Q6-b","text":{"en":[{"text":"when output increases from 90 units to 100 units, the firm suffers from diseconomies of scale"}],"zh":[{"text":"當產量由 90 單位增加至 100 單位時，該廠商會承受規模不經濟"}]}},{"id":"pp-DSE2025_P1_Q6-c","text":{"en":[{"text":"when output increases from 100 units to 105 units, the firm suffers a loss"}],"zh":[{"text":"當產量由 100 單位增加至 105 單位時，該廠商會承受虧損"}]}},{"id":"pp-DSE2025_P1_Q6-d","text":{"en":[{"text":"the profit-maximising output is 90 units"}],"zh":[{"text":"利潤極大化的產量是 90 單位"}]}}],"answerIndex":1,"tags":["B.costs","DSE2025/P1/Q6"],"provenance":{"en":[{"text":"HKDSE 2025 Paper 1 Q6"}],"zh":[{"text":"香港中學文憑考試 2025 卷一 第 6 題"}]},"lineage":{"rootId":"pp:DSE2025/P1/Q6"}},{"id":"pp-DSE2025_P1_Q11","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-DSE2025_P1_Q11-s-1","text":{"en":[{"text":"Miss Chan plans to open a flower shop. She is considering whether to open a flower shop at Flower Market Road, a district famous for having lots of flower shops, or to open at another location with no flower shops nearby."}],"zh":[{"text":"陳小姐計劃開設一間花店。她正考慮將花店開設在花墟道（一個以花店眾多而聞名的地區）還是開設在一個附近沒有花店的地點。"}]}},{"kind":"paragraph","id":"pp-DSE2025_P1_Q11-s-2","text":{"en":[{"text":"Based on the above information, an advantage for Miss Chan to open a flower shop at Flower Market Road is that she may be able to _____."}],"zh":[{"text":"根據上述資料，陳小姐將花店開設在花墟道的一個優點是，她可能可以 _____。"}]}}],"marks":1,"options":[{"id":"pp-DSE2025_P1_Q11-a","text":{"en":[{"text":"(1) only"}],"zh":[{"text":"只有(1)"}]}},{"id":"pp-DSE2025_P1_Q11-b","text":{"en":[{"text":"(2) only"}],"zh":[{"text":"只有(2)"}]}},{"id":"pp-DSE2025_P1_Q11-c","text":{"en":[{"text":"(1) and (3) only"}],"zh":[{"text":"只有(1)、(3)"}]}},{"id":"pp-DSE2025_P1_Q11-d","text":{"en":[{"text":"(2) and (3) only"}],"zh":[{"text":"只有(2)、(3)"}]}}],"answerIndex":1,"statements":[{"en":[{"text":"enjoy internal economies of scale in terms of lower transportation costs"}],"zh":[{"text":"在降低運輸成本方面享有內部規模經濟"}]},{"en":[{"text":"enjoy external economies of scale in terms of lower marketing costs"}],"zh":[{"text":"在降低營銷成本方面享有外部規模經濟"}]},{"en":[{"text":"sell flowers at a higher price due to keener competition among sellers"}],"zh":[{"text":"以更高價格出售花卉，因為賣家之間的競爭更激烈"}]}],"tags":["B.costs","DSE2025/P1/Q11"],"provenance":{"en":[{"text":"HKDSE 2025 Paper 1 Q11"}],"zh":[{"text":"香港中學文憑考試 2025 卷一 第 11 題"}]},"lineage":{"rootId":"pp:DSE2025/P1/Q11"}},{"id":"pp-DSE2026_P1_Q7","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-DSE2026_P1_Q7-s-1","text":{"en":[{"text":"A firm increases all its inputs to raise its output by 50%. As a result, the total cost of production rises by 20%. Which of the following best explains the above situation?"}],"zh":[{"text":"某廠商增加所有投入以將產出提高 50%。結果，總生產成本上升 20%。以下哪一項最能解釋上述情況？"}]}}],"marks":1,"options":[{"id":"pp-DSE2026_P1_Q7-a","text":{"en":[{"text":"The firm benefits from lower cost of borrowing due to the availability of more collateral."}],"zh":[{"text":"該廠商因可提供更多抵押品而享有較低的借貸成本。"}]}},{"id":"pp-DSE2026_P1_Q7-b","text":{"en":[{"text":"After exhausting all cheap sources of raw materials, the firm needs to purchase raw materials from more expensive sources."}],"zh":[{"text":"在用盡原料的所有廉價來源後，該廠商需要從更昂貴的來源購買原料。"}]}},{"id":"pp-DSE2026_P1_Q7-c","text":{"en":[{"text":"The firm incurs higher marketing and promotion costs due to excessive expansion of the entire industry."}],"zh":[{"text":"由於整個行業過度擴張，該廠商承擔了更高的市場推廣成本。"}]}},{"id":"pp-DSE2026_P1_Q7-d","text":{"en":[{"text":"The law of diminishing marginal returns applies to the firm’s production."}],"zh":[{"text":"邊際回報遞減定律適用於該廠商的生產。"}]}}],"answerIndex":0,"tags":["B.costs","DSE2026/P1/Q7"],"provenance":{"en":[{"text":"HKDSE 2026 Paper 1 Q7"}],"zh":[{"text":"香港中學文憑考試 2026 卷一 第 7 題"}]},"lineage":{"rootId":"pp:DSE2026/P1/Q7"}}],"layout":[],"flow":[{"type":"question","id":"pp-CE1992_P2_Q20"},{"type":"question","id":"pp-CE1994_P2_Q22"},{"type":"question","id":"pp-CE1995_P2_Q22"},{"type":"question","id":"pp-CE1996_P2_Q24"},{"type":"question","id":"pp-CE1998_P2_Q13"},{"type":"question","id":"pp-CE2000_P2_Q16"},{"type":"question","id":"pp-CE2000_P2_Q17"},{"type":"question","id":"pp-CE2001_P2_Q17"},{"type":"question","id":"pp-CE2005_P2_Q18"},{"type":"question","id":"pp-CE2006_P2_Q19"},{"type":"question","id":"pp-CE2007_P2_Q19"},{"type":"question","id":"pp-CE2009_P2_Q19"},{"type":"question","id":"pp-CE2011_P2_Q20"},{"type":"question","id":"pp-DSESP_P1_Q7"},{"type":"question","id":"pp-DSE2013_P1_Q4"},{"type":"question","id":"pp-DSE2013_P1_Q5"},{"type":"question","id":"pp-DSE2019_P1_Q5"},{"type":"question","id":"pp-DSE2020_P1_Q7"},{"type":"question","id":"pp-DSE2022_P1_Q7"},{"type":"question","id":"pp-DSE2025_P1_Q6"},{"type":"question","id":"pp-DSE2025_P1_Q11"},{"type":"question","id":"pp-DSE2026_P1_Q7"}],"createdAt":"2026-01-0