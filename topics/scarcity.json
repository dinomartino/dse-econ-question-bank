{"schemaVersion":1,"id":"pp-bank-scarcity","kind":"bank","title":{"en":[{"text":"Scarcity"}],"zh":[{"text":"稀少性"}]},"instructions":{"en":[],"zh":[]},"fonts":{"latin":"Times New Roman","eastAsia":"PMingLiU"},"pageSetup":{"paper":"A4","orientation":"portrait","margins":{"top":1296,"right":1296,"bottom":1440,"left":1296}},"header":{"enabled":false,"rule":false,"showOnFirstPage":true,"bands":[]},"footer":{"enabled":false,"rule":false,"showOnFirstPage":true,"bands":[]},"questions":[{"id":"pp-CE1991_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1991_P2_Q1-s-1","text":{"en":[{"text":"Owing to the problem of scarcity in a society, we have to"}],"zh":[{"text":"鑒於社會上的「稀少性」問題，我們須要"}]}}],"marks":1,"options":[{"id":"pp-CE1991_P2_Q1-a","text":{"en":[{"text":"(1) and (3) only"}],"zh":[{"text":"只有(1)、(3)"}]}},{"id":"pp-CE1991_P2_Q1-b","text":{"en":[{"text":"(1) and (4) only"}],"zh":[{"text":"只有(1)、(4)"}]}},{"id":"pp-CE1991_P2_Q1-c","text":{"en":[{"text":"(2) and (3) only"}],"zh":[{"text":"只有(2)、(3)"}]}},{"id":"pp-CE1991_P2_Q1-d","text":{"en":[{"text":"(2) and (4) only"}],"zh":[{"text":"只有(2)、(4)"}]}}],"answerIndex":3,"statements":[{"en":[{"text":"impose price controls."}],"zh":[{"text":"實施價格管制。"}]},{"en":[{"text":"make choices."}],"zh":[{"text":"作出選擇。"}]},{"en":[{"text":"adopt a planned economic system."}],"zh":[{"text":"採用計劃經濟。"}]},{"en":[{"text":"compete against one another."}],"zh":[{"text":"互相競爭。"}]}],"tags":["A.scarcity","CE1991/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 1991 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 1991 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE1991/P2/Q1"}},{"id":"pp-CE1991_P2_Q55","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1991_P2_Q55-s-1","text":{"en":[{"text":"Scarcity of commodity X will "},{"text":"NOT","bold":true},{"text":" occur when"}],"zh":[{"text":"在哪一種情況下，商品 X 不會有「稀少性」？"}]}}],"marks":1,"options":[{"id":"pp-CE1991_P2_Q55-a","text":{"en":[{"text":"there is a great supply of it."}],"zh":[{"text":"它有大量供應。"}]}},{"id":"pp-CE1991_P2_Q55-b","text":{"en":[{"text":"Nobody wants it."}],"zh":[{"text":"沒有人想得到它。"}]}},{"id":"pp-CE1991_P2_Q55-c","text":{"en":[{"text":"It is free of charge."}],"zh":[{"text":"它是免費的。"}]}},{"id":"pp-CE1991_P2_Q55-d","text":{"en":[{"text":"Only one person wants it."}],"zh":[{"text":"只有一個人想得到它。"}]}}],"answerIndex":1,"tags":["A.scarcity","CE1991/P2/Q55"],"provenance":{"en":[{"text":"HKCEE 1991 Paper 2 Q55"}],"zh":[{"text":"香港中學會考 1991 卷二 第 55 題"}]},"lineage":{"rootId":"pp:CE1991/P2/Q55"}},{"id":"pp-CE1992_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1992_P2_Q1-s-1","text":{"en":[{"text":"A scarce resource has the following characteristic:"}],"zh":[{"text":"「稀少性」資源有以下的特性："}]}}],"marks":1,"options":[{"id":"pp-CE1992_P2_Q1-a","text":{"en":[{"text":"Its supply is fixed."}],"zh":[{"text":"供應固定"}]}},{"id":"pp-CE1992_P2_Q1-b","text":{"en":[{"text":"It is difficult to find."}],"zh":[{"text":"不容易找到"}]}},{"id":"pp-CE1992_P2_Q1-c","text":{"en":[{"text":"It is in great demand."}],"zh":[{"text":"需求很大"}]}},{"id":"pp-CE1992_P2_Q1-d","text":{"en":[{"text":"It has a price on the market."}],"zh":[{"text":"在市場上有價"}]}}],"answerIndex":3,"tags":["A.scarcity","CE1992/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 1992 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 1992 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE1992/P2/Q1"}},{"id":"pp-CE1994_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1994_P2_Q1-s-1","text":{"en":[{"text":"Even though Japan is one of the richest economies in the world, it still has to face the problem of scarcity. This statement is"}],"zh":[{"text":"“雖然日本是全世界最富裕的國家之一，它仍要面對「稀少性」的問題。” 這句子是"}]}}],"marks":1,"options":[{"id":"pp-CE1994_P2_Q1-a","text":{"en":[{"text":"false, because scarcity only exists in developing countries."}],"zh":[{"text":"錯的，因為「稀少性」只存在於發展中的國家。"}]}},{"id":"pp-CE1994_P2_Q1-b","text":{"en":[{"text":"false, because Japan has a high gross national product (GNP)."}],"zh":[{"text":"錯的，因為日本國民生產總值高。"}]}},{"id":"pp-CE1994_P2_Q1-c","text":{"en":[{"text":"true, because what the Japanese have cannot satisfy all their wants."}],"zh":[{"text":"對的，因為日本人所擁有的不能滿足他們的全部慾望。"}]}},{"id":"pp-CE1994_P2_Q1-d","text":{"en":[{"text":"true, because Japan’s income is unevenly distributed."}],"zh":[{"text":"對的，因為日本收入分配不平均。"}]}}],"answerIndex":2,"tags":["A.scarcity","CE1994/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 1994 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 1994 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE1994/P2/Q1"}},{"id":"pp-CE1997_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1997_P2_Q1-s-1","text":{"en":[{"text":"Which of the following statements about scarcity is true?"}],"zh":[{"text":"下列哪一項關於「稀少性」的描述是正確的？"}]}}],"marks":1,"options":[{"id":"pp-CE1997_P2_Q1-a","text":{"en":[{"text":"Once a choice is made, the problem of scarcity is solved."}],"zh":[{"text":"在作出選擇後，稀少性的問題便獲得解決。"}]}},{"id":"pp-CE1997_P2_Q1-b","text":{"en":[{"text":"A good is scarce if not everyone has it."}],"zh":[{"text":"一物品若不是每個人都擁有，便是「稀少」的。"}]}},{"id":"pp-CE1997_P2_Q1-c","text":{"en":[{"text":"Scarcity means unlimited human wants."}],"zh":[{"text":"稀少性的意思是：人類有無窮的欲望。"}]}},{"id":"pp-CE1997_P2_Q1-d","text":{"en":[{"text":"Both rich people and poor people face the problem of scarcity."}],"zh":[{"text":"富者與貧者都面對稀少性的問題。"}]}}],"answerIndex":3,"tags":["A.scarcity","CE1997/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 1997 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 1997 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE1997/P2/Q1"}},{"id":"pp-CE1998_P2_Q54","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1998_P2_Q54-s-1","text":{"en":[{"text":"Which of the following statements about choice is "},{"text":"INCORRECT","bold":true},{"text":"?"}],"zh":[{"text":"下列哪一項關於選擇的描述不是正確的？"}]}}],"marks":1,"options":[{"id":"pp-CE1998_P2_Q54-a","text":{"en":[{"text":"People have to choose in order to avoid competition."}],"zh":[{"text":"因為要避免競爭，我們須作出選擇。"}]}},{"id":"pp-CE1998_P2_Q54-b","text":{"en":[{"text":"People have to choose if there is scarcity"}],"zh":[{"text":"因為「稀少性」問題，我們須作出選擇。"}]}},{"id":"pp-CE1998_P2_Q54-c","text":{"en":[{"text":"People choose to option with the least cost."}],"zh":[{"text":"我們所選擇的，都是代價最低的。"}]}},{"id":"pp-CE1998_P2_Q54-d","text":{"en":[{"text":"People choose the most preferred option."}],"zh":[{"text":"我們所選擇的，都是最偏好的。"}]}}],"answerIndex":0,"tags":["A.scarcity","CE1998/P2/Q54"],"provenance":{"en":[{"text":"HKCEE 1998 Paper 2 Q54"}],"zh":[{"text":"香港中學會考 1998 卷二 第 54 題"}]},"lineage":{"rootId":"pp:CE1998/P2/Q54"}},{"id":"pp-CE1999_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE1999_P2_Q1-s-1","text":{"en":[{"text":"The existence of scarcity implies that"}],"zh":[{"text":"\t存在「稀少性」的問題是意味著"}]}}],"marks":1,"options":[{"id":"pp-CE1999_P2_Q1-a","text":{"en":[{"text":"the economy is planned economy."}],"zh":[{"text":"該經濟是計劃經濟。"}]}},{"id":"pp-CE1999_P2_Q1-b","text":{"en":[{"text":"there is competition for the good."}],"zh":[{"text":"為了獲得某物品而出現競爭。"}]}},{"id":"pp-CE1999_P2_Q1-c","text":{"en":[{"text":"effective price control is imposed on that good."}],"zh":[{"text":"對某物品實施了有效的物價管制。"}]}},{"id":"pp-CE1999_P2_Q1-d","text":{"en":[{"text":"wealth is not evenly distributed."}],"zh":[{"text":"財富並未平均分配。"}]}}],"answerIndex":1,"tags":["A.scarcity","CE1999/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 1999 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 1999 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE1999/P2/Q1"}},{"id":"pp-AL2002_P1_Q17","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-AL2002_P1_Q17-s-1","text":{"en":[{"text":"Which of the following statements about scarcity and shortage is correct?"}],"zh":[{"text":"下列哪一項關於稀少性和短缺的陳述是正確的？"}]}}],"marks":1,"options":[{"id":"pp-AL2002_P1_Q17-a","text":{"en":[{"text":"Scarcity implies shortage."}],"zh":[{"text":"稀少性意味著短缺。"}]}},{"id":"pp-AL2002_P1_Q17-b","text":{"en":[{"text":"The existence of market prices implies scarcity."}],"zh":[{"text":"市場價格的存在意味著稀少性。"}]}},{"id":"pp-AL2002_P1_Q17-c","text":{"en":[{"text":"Shortages are caused by reduction in supply."}],"zh":[{"text":"短缺是由供應減少所引致的。"}]}},{"id":"pp-AL2002_P1_Q17-d","text":{"en":[{"text":"There is no scarcity in a one-man economy."}],"zh":[{"text":"在一人經濟體系中，不存在稀少性。"}]}}],"answerIndex":1,"tags":["A.scarcity","AL2002/P1/Q17"],"provenance":{"en":[{"text":"HKALE 2002 Paper 1 Q17"}],"zh":[{"text":"香港高級程度會考 2002 卷一 第 17 題"}]},"lineage":{"rootId":"pp:AL2002/P1/Q17"}},{"id":"pp-CE2004_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE2004_P2_Q1-s-1","text":{"en":[{"text":"The existence of scarcity implies that"}],"zh":[{"text":"「稀少性」的存在，意味着"}]}}],"marks":1,"options":[{"id":"pp-CE2004_P2_Q1-a","text":{"en":[{"text":"resources will be allocated by the price mechanism."}],"zh":[{"text":"資源會由價格機制配置。"}]}},{"id":"pp-CE2004_P2_Q1-b","text":{"en":[{"text":"all markets are perfectly competitive."}],"zh":[{"text":"所有市場都是完全競爭的。"}]}},{"id":"pp-CE2004_P2_Q1-c","text":{"en":[{"text":"the quantity supplied of all goods is fixed."}],"zh":[{"text":"所有物品的供應量都是固定的。"}]}},{"id":"pp-CE2004_P2_Q1-d","text":{"en":[{"text":"people need to pay for what they want."}],"zh":[{"text":"人們需付出代價以獲取他們想要的東西。"}]}}],"answerIndex":3,"tags":["A.scarcity","CE2004/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 2004 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 2004 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE2004/P2/Q1"}},{"id":"pp-AL2004_P1_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-AL2004_P1_Q1-s-1","text":{"en":[{"text":"Scarcity implies"}],"zh":[{"text":"\t稀少性意味著"}]}}],"marks":1,"options":[{"id":"pp-AL2004_P1_Q1-a","text":{"en":[{"text":"everything is not enough."}],"zh":[{"text":"所有東西都不足夠。"}]}},{"id":"pp-AL2004_P1_Q1-b","text":{"en":[{"text":"there is a shortage, and without a shortage there will be no price."}],"zh":[{"text":"存在短缺，而沒有短缺就不會有價格。"}]}},{"id":"pp-AL2004_P1_Q1-c","text":{"en":[{"text":"that an individual is willing to sacrifice something for something else."}],"zh":[{"text":"個人願意為了某些事物而犧牲其他事物。"}]}},{"id":"pp-AL2004_P1_Q1-d","text":{"en":[{"text":"a market will emerge."}],"zh":[{"text":"市場將會出現。"}]}}],"answerIndex":2,"tags":["A.scarcity","AL2004/P1/Q1"],"provenance":{"en":[{"text":"HKALE 2004 Paper 1 Q1"}],"zh":[{"text":"香港高級程度會考 2004 卷一 第 1 題"}]},"lineage":{"rootId":"pp:AL2004/P1/Q1"}},{"id":"pp-CE2005_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE2005_P2_Q1-s-1","text":{"en":[{"text":"The existence of scarcity implies that"}],"zh":[{"text":"「稀少性」的存在，意味着"}]}}],"marks":1,"options":[{"id":"pp-CE2005_P2_Q1-a","text":{"en":[{"text":"there is no such thing as free goods."}],"zh":[{"text":"沒有「免費物品」這種東西。"}]}},{"id":"pp-CE2005_P2_Q1-b","text":{"en":[{"text":"human wants are unlimited."}],"zh":[{"text":"人類慾望無窮。"}]}},{"id":"pp-CE2005_P2_Q1-c","text":{"en":[{"text":"each and every economic good has a positive money price."}],"zh":[{"text":"每項經濟物品都有一個大於零的金錢價格。"}]}},{"id":"pp-CE2005_P2_Q1-d","text":{"en":[{"text":"there is a cost in obtaining some goods."}],"zh":[{"text":"要獲得某些物品是有代價的。"}]}}],"answerIndex":3,"tags":["A.scarcity","CE2005/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 2005 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 2005 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE2005/P2/Q1"}},{"id":"pp-AL2006_P1_Q24","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-AL2006_P1_Q24-s-1","text":{"en":[{"text":"In a one-man economy, there will still be"}],"zh":[{"text":"在一人經濟體系中，仍然會有"}]}}],"marks":1,"options":[{"id":"pp-AL2006_P1_Q24-a","text":{"en":[{"text":"property rights."}],"zh":[{"text":"產權。"}]}},{"id":"pp-AL2006_P1_Q24-b","text":{"en":[{"text":"shortage."}],"zh":[{"text":"短缺。"}]}},{"id":"pp-AL2006_P1_Q24-c","text":{"en":[{"text":"exchange."}],"zh":[{"text":"交換。"}]}},{"id":"pp-AL2006_P1_Q24-d","text":{"en":[{"text":"scarcity."}],"zh":[{"text":"稀少性。"}]}}],"answerIndex":3,"tags":["A.scarcity","AL2006/P1/Q24"],"provenance":{"en":[{"text":"HKALE 2006 Paper 1 Q24"}],"zh":[{"text":"香港高級程度會考 2006 卷一 第 24 題"}]},"lineage":{"rootId":"pp:AL2006/P1/Q24"}},{"id":"pp-AL2007_P1_Q3","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-AL2007_P1_Q3-s-1","text":{"en":[{"text":"Scarcity implies"}],"zh":[{"text":"\t稀少性意味著"}]}}],"marks":1,"options":[{"id":"pp-AL2007_P1_Q3-a","text":{"en":[{"text":"the market is the most efficient place for allocating resources."}],"zh":[{"text":"市場是分配資源最有效率的地方。"}]}},{"id":"pp-AL2007_P1_Q3-b","text":{"en":[{"text":"shortage if the market does not exist."}],"zh":[{"text":"若市場不存在，便會出現短缺。"}]}},{"id":"pp-AL2007_P1_Q3-c","text":{"en":[{"text":"the concept of equilibrium is essential."}],"zh":[{"text":"均衡的概念是必要的。"}]}},{"id":"pp-AL2007_P1_Q3-d","text":{"en":[{"text":"some people must be discriminated against in a society."}],"zh":[{"text":"社會中某些人必然會被歧視。"}]}}],"answerIndex":3,"tags":["A.scarcity","AL2007/P1/Q3"],"provenance":{"en":[{"text":"HKALE 2007 Paper 1 Q3"}],"zh":[{"text":"香港高級程度會考 2007 卷一 第 3 題"}]},"lineage":{"rootId":"pp:AL2007/P1/Q3"}},{"id":"pp-CE2008_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE2008_P2_Q1-s-1","text":{"en":[{"text":"From the viewpoint of society,"}],"zh":[{"text":"從社會的角度出發，"}]}}],"marks":1,"options":[{"id":"pp-CE2008_P2_Q1-a","text":{"en":[{"text":"people will not compete for free goods."}],"zh":[{"text":"人們不會為「免費物品」而競爭。"}]}},{"id":"pp-CE2008_P2_Q1-b","text":{"en":[{"text":"money price is the only criterion of competition for scarce goods."}],"zh":[{"text":"金錢價格是「稀少性物品」的唯一競爭準則。"}]}},{"id":"pp-CE2008_P2_Q1-c","text":{"en":[{"text":"resources with alternative uses are scarce."}],"zh":[{"text":"有其他用途的資源都是「稀少」的。"}]}},{"id":"pp-CE2008_P2_Q1-d","text":{"en":[{"text":"there is no scarcity in a barter economy."}],"zh":[{"text":"以物易物的經濟是沒有「稀少性」的。"}]}}],"answerIndex":0,"tags":["A.scarcity","CE2008/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 2008 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 2008 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE2008/P2/Q1"}},{"id":"pp-AL2009_P1_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-AL2009_P1_Q1-s-1","text":{"en":[{"text":"Which of the following statements about scarcity and shortage is correct?"}],"zh":[{"text":"下列哪一項關於稀少性與短缺的陳述是正確的？"}]}}],"marks":1,"options":[{"id":"pp-AL2009_P1_Q1-a","text":{"en":[{"text":"Whenever there is shortage, there must be scarcity."}],"zh":[{"text":"每當有短缺，就必然有稀少性。"}]}},{"id":"pp-AL2009_P1_Q1-b","text":{"en":[{"text":"In a one-man economy, there may be shortage."}],"zh":[{"text":"在一人經濟體系中，可能會出現短缺。"}]}},{"id":"pp-AL2009_P1_Q1-c","text":{"en":[{"text":"Whenever there is scarcity, there must be shortage."}],"zh":[{"text":"每當有稀少性，就必然有短缺。"}]}},{"id":"pp-AL2009_P1_Q1-d","text":{"en":[{"text":"Scarcity necessarily implies competition."}],"zh":[{"text":"稀少性必然意指競爭。"}]}}],"answerIndex":0,"tags":["A.scarcity","AL2009/P1/Q1"],"provenance":{"en":[{"text":"HKALE 2009 Paper 1 Q1"}],"zh":[{"text":"香港高級程度會考 2009 卷一 第 1 題"}]},"lineage":{"rootId":"pp:AL2009/P1/Q1"}},{"id":"pp-CE2010_P2_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-CE2010_P2_Q1-s-1","text":{"en":[{"text":"Which one of the following statements about scarcity is correct?"}],"zh":[{"text":"下列哪項關於「稀少性」的說法是正確的？"}]}}],"marks":1,"options":[{"id":"pp-CE2010_P2_Q1-a","text":{"en":[{"text":"A good is scarce when only a small quantity of it is available."}],"zh":[{"text":"若一種物品只有少量供應，它便是「稀少」的。"}]}},{"id":"pp-CE2010_P2_Q1-b","text":{"en":[{"text":"A good is scarce when people want to have more of it."}],"zh":[{"text":"若人們想獲得更多某種物品，它便是「稀少」的。"}]}},{"id":"pp-CE2010_P2_Q1-c","text":{"en":[{"text":"There is no scarcity in a planned economy."}],"zh":[{"text":"計劃經濟中沒有「稀少性」這回事。"}]}},{"id":"pp-CE2010_P2_Q1-d","text":{"en":[{"text":"The problem of scarcity can be solved by adjusting prices."}],"zh":[{"text":"「稀少性」的問題可透過調節價格來解決。"}]}}],"answerIndex":1,"tags":["A.scarcity","CE2010/P2/Q1"],"provenance":{"en":[{"text":"HKCEE 2010 Paper 2 Q1"}],"zh":[{"text":"香港中學會考 2010 卷二 第 1 題"}]},"lineage":{"rootId":"pp:CE2010/P2/Q1"}},{"id":"pp-DSESP_P1_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-DSESP_P1_Q1-s-1","text":{"en":[{"text":"The existence of scarcity implies that"}],"zh":[{"text":"「稀少性」的存在意味着"}]}}],"marks":1,"options":[{"id":"pp-DSESP_P1_Q1-a","text":{"en":[{"text":"human wants are unlimited."}],"zh":[{"text":"人類慾望無窮。"}]}},{"id":"pp-DSESP_P1_Q1-b","text":{"en":[{"text":"all goods are economic goods."}],"zh":[{"text":"所有物品都是經濟物品。"}]}},{"id":"pp-DSESP_P1_Q1-c","text":{"en":[{"text":"there is a cost in obtaining some goods."}],"zh":[{"text":"要獲得某些物品是有代價的。"}]}},{"id":"pp-DSESP_P1_Q1-d","text":{"en":[{"text":"each and every economic good must have a market price."}],"zh":[{"text":"每一經濟物品都必定有一個市價。"}]}}],"answerIndex":2,"tags":["A.scarcity","DSESP/P1/Q1"],"provenance":{"en":[{"text":"HKDSE Sample Paper Paper 1 Q1"}],"zh":[{"text":"香港中學文憑考試 樣本試卷 卷一 第 1 題"}]},"lineage":{"rootId":"pp:DSESP/P1/Q1"}},{"id":"pp-DSEPP_P1_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-DSEPP_P1_Q1-s-1","text":{"en":[{"text":"In the absence of scarcity,"}],"zh":[{"text":"沒有稀少性，"}]}}],"marks":1,"options":[{"id":"pp-DSEPP_P1_Q1-a","text":{"en":[{"text":"(1) and (2) only"}],"zh":[{"text":"只有 (1)、(2)"}]}},{"id":"pp-DSEPP_P1_Q1-b","text":{"en":[{"text":"(1) and (3) only"}],"zh":[{"text":"只有 (1)、(3)"}]}},{"id":"pp-DSEPP_P1_Q1-c","text":{"en":[{"text":"(2) and (3) only"}],"zh":[{"text":"只有 (2)、(3)"}]}},{"id":"pp-DSEPP_P1_Q1-d","text":{"en":[{"text":"(1), (2) and (3)"}],"zh":[{"text":"(1)、(2) 及 (3)"}]}}],"answerIndex":0,"statements":[{"en":[{"text":"there will be no discrimination."}],"zh":[{"text":"歧視不會存在。"}]},{"en":[{"text":"there will be no market price."}],"zh":[{"text":"市價不會存在。"}]},{"en":[{"text":"there will be no goods."}],"zh":[{"text":"物品不會存在。"}]}],"tags":["A.scarcity","DSEPP/P1/Q1"],"provenance":{"en":[{"text":"HKDSE Practice Paper Paper 1 Q1"}],"zh":[{"text":"香港中學文憑考試 練習卷 卷一 第 1 題"}]},"lineage":{"rootId":"pp:DSEPP/P1/Q1"}},{"id":"pp-DSE2024_P1_Q2","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-DSE2024_P1_Q2-s-1","text":{"en":[{"text":"Which of the following situations imply the existence of scarcity?"}],"zh":[{"text":"下列哪些情況意味着稀少性的存在？"}]}}],"marks":1,"options":[{"id":"pp-DSE2024_P1_Q2-a","text":{"en":[{"text":"(1) and (2) only"}],"zh":[{"text":"只有 (1)、(2)"}]}},{"id":"pp-DSE2024_P1_Q2-b","text":{"en":[{"text":"(1) and (3) only"}],"zh":[{"text":"只有 (1)、(3)"}]}},{"id":"pp-DSE2024_P1_Q2-c","text":{"en":[{"text":"(2) and (3) only"}],"zh":[{"text":"只有 (2)、(3)"}]}},{"id":"pp-DSE2024_P1_Q2-d","text":{"en":[{"text":"(1), (2) and (3)"}],"zh":[{"text":"(1)、(2) 及 (3)"}]}}],"answerIndex":3,"statements":[{"en":[{"text":"People need to choose between two options."}],"zh":[{"text":"人們須從兩個選項中擇其一。"}]},{"en":[{"text":"People can obtain what they want by paying the market price."}],"zh":[{"text":"人們可支付市價以獲得想要的東西。"}]},{"en":[{"text":"People cannot obtain what they want even after queuing up for hours."}],"zh":[{"text":"人們即使排隊輪候數小時仍未能獲得想要的東西。"}]}],"tags":["A.scarcity","DSE2024/P1/Q2"],"provenance":{"en":[{"text":"HKDSE 2024 Paper 1 Q2"}],"zh":[{"text":"香港中學文憑考試 2024 卷一 第 2 題"}]},"lineage":{"rootId":"pp:DSE2024/P1/Q2"}},{"id":"pp-DSE2026_P1_Q1","type":"mcq","blocks":[{"kind":"paragraph","id":"pp-DSE2026_P1_Q1-s-1","text":{"en":[{"text":"In the absence of scarcity, ______ does "},{"text":"NOT","bold":true},{"text":" exist."}],"zh":[{"text":"沒有稀少性，______ 並不存在。"}]}}],"marks":1,"options":[{"id":"pp-DSE2026_P1_Q1-a","text":{"en":[{"text":"(1) and (2) only"}],"zh":[{"text":"只有 (1)、(2)\t"}]}},{"id":"pp-DSE2026_P1_Q1-b","text":{"en":[{"text":"(1) and (3) only"}],"zh":[{"text":"只有 (1)、(3)\t"}]}},{"id":"pp-DSE2026_P1_Q1-c","text":{"en":[{"text":"(2) and (3) only"}],"zh":[{"text":"只有 (2)、(3)\t"}]}},{"id":"pp-DSE2026_P1_Q1-d","text":{"en":[{"text":"(1), (2) and (3)"}],"zh":[{"text":"(1)、(2) 及 (3)\t"}]}}],"answerIndex":3,"statements":[{"en":[{"text":"interest"}],"zh":[{"text":"利息\t"}]},{"en":[{"text":"comparative advantage"}],"zh":[{"text":"比較優勢\t"}]},{"en":[{"text":"shortage"}],"zh":[{"text":"短缺\t"}]}],"tags":["A.scarcity","DSE2026/P1/Q1"],"provenance":{"en":[{"text":"HKDSE 2026 Paper 1 Q1"}],"zh":[{"text":"香港中學文憑考試 2026 卷一 第 1 題"}]},"lineage":{"rootId":"pp:DSE2026/P1/Q1"}}],"layout":[],"flow":[{"type":"question","id":"pp-CE1991_P2_Q1"},{"type":"question","id":"pp-CE1991_P2_Q55"},{"typ